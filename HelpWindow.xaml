<Window x:Class="TIAgent.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TIAgent MCP Server — asriakdeniz@gmail.com — Yardım &amp; Protokoller"
        Width="860" Height="740"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Background="#0F172A" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="TIAgent MCP Server — asriakdeniz@gmail.com"
                               Foreground="White" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtHeaderSubtitle"
                               Text="Çoklu Ajan Protokolleri (MCP, OpenAPI/Swagger, CLI, Hot-Folder), Openness Mimarisi ve Kılavuz (V14 SP1 – V21)"
                               Foreground="#94A3B8" FontSize="12.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN SCROLLABLE CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14">
            <StackPanel>

                <!-- ========================================== -->
                <!-- TURKISH CONTENT PANEL                      -->
                <!-- ========================================== -->
                <StackPanel x:Name="PnlHelpContentTr">

                    <!-- HAKKINDA & GELİŞTİRİCİ KARTI -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Hakkında &amp; Geliştirici Bilgileri"
                                           Foreground="#38BDF8" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Foreground="#F8FAFC" FontSize="13" Margin="0,2,0,2" TextWrapping="Wrap">
                                    <Run Text="Geliştirici: " Foreground="#94A3B8"/>
                                    <Run Text="Asri Akdeniz" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Foreground="#F8FAFC" FontSize="13" Margin="0,2,0,2" TextWrapping="Wrap">
                                    <Run Text="E-Posta: " Foreground="#94A3B8"/>
                                    <Hyperlink NavigateUri="mailto:asriakdeniz@gmail.com" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#38BDF8">
                                        asriakdeniz@gmail.com
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Foreground="#F8FAFC" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap">
                                    <Run Text="Web Sitesi: " Foreground="#94A3B8"/>
                                    <Hyperlink NavigateUri="https://www.asriakdeniz.com" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#38BDF8">
                                        www.asriakdeniz.com
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 1. KÖPRÜSÜN VE PROGRAMCISIN KOMUTLARI -->
                    <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button x:Name="BtnCopyRolePrompt"
                                        Content="📋 AI Kural Metnini Panoya Kopyala"
                                        Background="#0F766E" Foreground="White" FontWeight="SemiBold"
                                        Padding="12,5" FontSize="12" BorderThickness="0" Cursor="Hand"
                                        DockPanel.Dock="Right" Click="BtnCopyRolePrompt_Click"/>
                                <TextBlock Text="1. 'Köprüsün' ve 'Programcısın' Komutları (AI'a Önceden Anlatılmalıdır)"
                                           FontWeight="Bold" Foreground="#166534" FontSize="14.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>

                            <TextBlock Foreground="#1E293B" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10">
                                AI ile çalışırken hem TIAgent'ın kendi C# kaynak kodları hem de TIA Portal PLC otomasyon görevleri aynı çalışma alanında bulunabilir. AI'ın PLC programı yazarken TIAgent'ın C# kodlarını değiştirmemesi için çalışma dizinindeki GEMINI.md dosyasında veya sohbetin başında bu iki kavram AI'a önceden tanıtılmalıdır:
                            </TextBlock>

                            <Border Background="White" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="• 'Köprüsün' Kelimesinin Anlamı (PLC Otomasyon &amp; Ladder Üretim Modu)"
                                               FontWeight="Bold" Foreground="#0F766E" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="#334155" FontSize="12.5" TextWrapping="Wrap">
                                        Kullanıcı cümleye &quot;Köprüsün&quot; diyerek başladığında (Örn: &quot;Köprüsün, S7-1214 PLC'de piston basınç testi için Ladder dilinde program yaz&quot;), AI kesinlikle TIAgent C# kaynak kodlarında (*.cs, *.xaml, *.csproj) hiçbir geliştirme veya değişiklik yapmaz. Yalnızca istenen PLC senaryosu için I/O Taglarını, Global/Instance DB'leri ve SimaticML XML (Ladder / SCL) blok paketini hazırlayıp http://localhost:19520/api/package üzerinden TIAgent'a gönderir ve TIA Portal'a işlenmesini sağlar.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="White" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="• 'Programcısın' Kelimesinin Anlamı (TIAgent Yazılım Geliştirme Modu)"
                                               FontWeight="Bold" Foreground="#B45309" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="#334155" FontSize="12.5" TextWrapping="Wrap">
                                        Kullanıcı cümleye &quot;Programcısın&quot; diyerek başladığında (Örn: &quot;Programcısın, TIAgent arayüzüne yardım penceresi ekle&quot;), AI doğrudan TIAgent masaüstü yazılımının kendi C# / WPF kaynak kodlarında (TIAgentMCPServer.csproj) geliştirme veya hata düzeltmesi yapar, dotnet build ile derler ve uygulamayı yeniden başlatır.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="TxtCopyFeedback" Text="" Foreground="#15803D" FontWeight="SemiBold" FontSize="12" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. SIEMENS TIA PORTAL OPENNESS DLL GEREKSİNİMLERİ -->
                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="2. Siemens TIA Portal Openness DLL'leri ve Kurulum Gereksinimleri"
                                       FontWeight="Bold" Foreground="#92400E" FontSize="14.5" Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <TextBlock Foreground="#1E293B" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,6">
                                • Lisans ve GitHub Politikası: Siemens'in telif ve lisans koşulları gereği GitHub deposunda Siemens.Engineering.dll veya Siemens.Engineering.Hmi.dll gibi ticari DLL dosyaları paylaşılmaz.
                            </TextBlock>
                            <TextBlock Foreground="#1E293B" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,8">
                                • Otomatik Yerel DLL Tespiti: TIAgent, derleme zamanında statik DLL referansına ihtiyaç duymaz (Reflection kullanır). Çalışma zamanında ise bilgisayarınızda kurulu olan TIA Portal sürümlerini tarar ve C:\Program Files\Siemens\Automation\Portal Vxx\PublicAPI\Vxx\Siemens.Engineering.dll dizininden ilgili DLL'leri otomatik olarak yükler. Üstteki &quot;TIA Sürümü&quot; kutusunda yalnızca bilgisayarınızda kurulu olan TIA Portal sürümleri listelenir.
                            </TextBlock>

                            <Border Background="White" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Sorunsuz Bağlantı İçin Kontrol Listesi:"
                                               FontWeight="Bold" Foreground="#92400E" FontSize="12.5" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                        1) Bilgisayarınızda Siemens TIA Portal (V14 SP1 – V21) ve kurulumda seçilen &quot;TIA Portal Openness&quot; bileşeni yüklü olmalıdır.
                                    </TextBlock>
                                    <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                        2) Windows kullanıcınız &quot;Siemens TIA Openness&quot; yerel kullanıcı grubuna eklenmiş olmalıdır. Ana ekrandaki &quot;Openness grubuna ekle&quot; butonu yönetici yetkisiyle bu işlemi otomatik yapar (ilk kez eklendiğinde Windows oturumunu kapatıp açmanız gerekir).
                                    </TextBlock>
                                    <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap">
                                        3) TIAgent ilk kez TIA Portal'a bağlanırken TIA Portal ekranında açılan Openness güvenlik penceresinde &quot;Yes to all&quot; (Tümüne Evet) seçeneği onaylanmalıdır.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 3. TIA PORTAL İLE AI ARASINDAKİ HABERLEŞME MİMARİSİ -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="3. TIA Portal ile AI Arasındaki Haberleşme Mimarisi"
                                       FontWeight="Bold" Foreground="#0F172A" FontSize="14.5" Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <TextBlock Foreground="#334155" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,8">
                                TIAgent çalışırken yerel bilgisayarda http://localhost:19520 adresinde bir HTTP Köprü API sunucusu ve Packages/Inbox sıcak klasör izleyicisi çalıştırır. AI, hazırladığı PLC paketlerini bu köprü üzerinden TIAgent'a gönderir:
                            </TextBlock>

                            <Border Background="#0F172A" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Foreground="#38BDF8" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="GET  http://localhost:19520/api/status   → Bağlı TIA Portal, açık proje, aktif PLC, mevcut tag/blok listesi ve son adımları döner."/>
                                    <TextBlock Foreground="#4ADE80" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="POST http://localhost:19520/api/package  → PLC I/O Tagları, Global/Instance DB ve SimaticML XML (LAD/SCL) blok paketini gönderir."/>
                                    <TextBlock Foreground="#FBBF24" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                               Text="POST http://localhost:19520/api/command  → Blok/Tag silme, derleme, onaylama veya proje okuma komutlarını iletir."/>
                                </StackPanel>
                            </Border>

                            <TextBlock Foreground="#0F172A" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"
                                       Text="İşlem Modları (Onay Bekle vs Onay Bekleme):"/>
                            <TextBlock Foreground="#334155" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,4">
                                • Onay Bekle: AI'dan gelen paketler ve silme komutları doğrudan TIA Portal'a yazılmaz; ana pencerenin altındaki onay çubuğuna düşer. &quot;Şemayı / Tagları Gör&quot; butonuyla oluşturulan Ladder networkleri ve tag adresleri incelenebilir, &quot;Kabul Et&quot; butonuna basıldığında TIA Portal'a aktarılıp derlenir.
                            </TextBlock>
                            <TextBlock Foreground="#334155" FontSize="12.5" TextWrapping="Wrap">
                                • Onay Bekleme: AI'dan gelen paketler onay sormadan doğrudan TIA Portal'a aktarılır, mevcut blokların yedeği Backups/ klasörüne alınır ve PLC yazılımı otomatik olarak derlenir (Compile).
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 4. DONANIM VE TECHNOLOGY OBJECT KÖPRÜSÜ -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,8,0,6">
                        <StackPanel>
                            <TextBlock Text="4. Donanım (Devices &amp; Networks) ve Technology Object Talimatları"
                                       FontWeight="Bold" Foreground="#1E3A8A" FontSize="14.5" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBlock Foreground="#1E293B" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,6">
                                Köprü paketleri (POST /api/package) yazılım bloklarının yanında donanım talimatları da taşıyabilir. TIAgent bunları bloklardan ÖNCE uygular; böylece MC_Power / MC_MoveAbsolute gibi bloklar oluşturulan eksenlere doğrudan bağlanabilir.
                            </TextBlock>
                            <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                • HardwareDevices: PROFINET cihaz ekleme (SINAMICS V90 / G120 / S210, ET200SP, GSDML ile yüklenmiş her cihaz). İsim, IP adresi, PROFINET cihaz adı, PLC IO-System bağlantısı ve telegram / modül takma.
                            </TextBlock>
                            <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                • PlcModules: PLC rack'ine SM / CM / SB modülü takma ve I/Q başlangıç adresi atama. PlcIpAddress ile PLC IP adresi ayarlanır.
                            </TextBlock>
                            <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                • TechnologyObjects: TO_PositioningAxis, TO_SpeedAxis, TO_SynchronousAxis, TO_ExternalEncoder, PID_Compact, PID_3Step, PID_Temp oluşturma; sürücü telegramına bağlama ve parametre yazma.
                            </TextBlock>
                            <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8">
                                • DevicesToDelete / TechnologyObjectsToDelete: Cihaz, modül ve TO silme (&quot;*&quot; = hedef PLC hariç tümü).
                            </TextBlock>
                            <Border Background="#0F172A" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Foreground="#38BDF8" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="GET  http://localhost:19520/api/hardware  → Projedeki cihazlar, modüller, IP adresleri ve Technology Object'ler."/>
                                    <TextBlock Foreground="#4ADE80" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                               Text="GET  http://localhost:19520/api/gsd?q=v90  → TIA Portal'a yüklü GSDML dosyaları, DAP ve telegram/modül TypeIdentifier'ları."/>
                                </StackPanel>
                            </Border>
                            <TextBlock Foreground="#92400E" FontSize="12" TextWrapping="Wrap">
                                Not: Eklenecek cihazın TIA Portal donanım kataloğunda bulunması gerekir. GSDML cihazlar için TIA Portal'da &quot;Options → Manage general station description files (GSD)&quot; ile ilgili GSDML dosyası önceden yüklenmelidir (ör. SINAMICS V90 PN GSDML). TIAgent GsdKeyword ile yüklü dosyayı otomatik bulur.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 5. ÇOKLU YAPAY ZEKA AJAN PROTOKOLLERİ -->
                    <Border Background="#F8FAFC" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="8" Padding="16,14" Margin="0,8,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button x:Name="BtnCopyAgentProtocols"
                                        Content="📋 Çoklu Ajan Kurulum Kılavuzunu Panoya Kopyala"
                                        Background="#0284C7" Foreground="White" FontWeight="SemiBold"
                                        Padding="12,5" FontSize="12" BorderThickness="0" Cursor="Hand"
                                        DockPanel.Dock="Right" Click="BtnCopyAgentProtocols_Click"/>
                                <TextBlock Text="5. Çoklu Ajan Protokolleri (Cursor, Copilot, OpenCode, Hermes, Claude Code)"
                                           FontWeight="Bold" Foreground="#0369A1" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>

                            <TextBlock Foreground="#334155" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10">
                                TIAgent MCP Server; yalnızca tek bir yapay zeka ile değil, geliştiricilerin kullandığı tüm modern LLM ajanları ile doğrudan ve standart protokoller üzerinden haberleşebilecek şekilde tasarlanmıştır:
                            </TextBlock>

                            <!-- A) MCP -->
                            <Border Background="White" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="A) Model Context Protocol (MCP) — Cursor, VS Code / GitHub Copilot, Cline, Roo Code, Claude"
                                               FontWeight="Bold" Foreground="#0284C7" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6">
                                        Proje kökündeki tiagent_mcp.py betiği standart Model Context Protocol (JSON-RPC 2.0 stdio) sunucusu çalıştırır. Herhangi bir harici kütüphane gerektirmez (pure Python standard library). Cursor veya VS Code bu betiği çalıştırarak TIAgent araçlarını doğrudan yerel fonksiyon olarak tanır:
                                    </TextBlock>
                                    <Border Background="#0F172A" CornerRadius="5" Padding="10,8" Margin="0,0,0,6">
                                        <TextBlock Foreground="#38BDF8" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                                                   Text="• tiagent_status()         → TIA Portal bağlantısını, PLC adını ve derleme loglarını döner.&#x0a;• tiagent_import_package() → LAD (SimaticML XML), SCL, DB, Tag ve donanım paketini TIA'ya aktarır.&#x0a;• tiagent_send_command()   → Doğal dilde komut iletir (örn: 'DB_V90 veri blogunu sil').&#x0a;• tiagent_delete()         → Blokları, tag tablolarını veya cihazları projeden temizler.&#x0a;• tiagent_search_gsd()     → TIA Portal GSDML kataloğunda sürücü/modül arar."/>
                                    </Border>
                                    <TextBlock Foreground="#475569" FontSize="11.5" TextWrapping="Wrap"
                                               Text="Yapılandırma Dosyaları: Cursor için .cursor/mcp.json, VS Code / Copilot için .vscode/mcp.json dosyaları projenizde otomatik oluşturulmuştur."/>
                                </StackPanel>
                            </Border>

                            <!-- B) OpenAPI / Swagger -->
                            <Border Background="White" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="B) OpenAPI 3.0 / Swagger — Hermes (Nous Hermes), LangChain, AutoGen, CrewAI, Custom GPTs"
                                               FontWeight="Bold" Foreground="#0D9488" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6">
                                        TIAgent HTTP sunucusu canlı OpenAPI 3.0 şeması sunar. LangChain, AutoGen, CrewAI veya açık kaynaklı Hermes modelleri bu URL üzerinden tek satırda TIAgent araçlarını içe aktarabilir:
                                    </TextBlock>
                                    <Border Background="#0F172A" CornerRadius="5" Padding="10,8" Margin="0,0,0,6">
                                        <TextBlock Foreground="#4ADE80" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                                                   Text="GET http://localhost:19520/swagger.json  veya  http://localhost:19520/openapi.json&#x0a;CORS desteği aktiftir (Access-Control-Allow-Origin: * ve OPTIONS 204 preflight)."/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- C) CLI -->
                            <Border Background="White" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="C) Tek Satırlık CLI (tiagent.bat &amp; tiagent.ps1) — OpenCode, Aider ve Terminal Ajanları"
                                               FontWeight="Bold" Foreground="#D97706" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6">
                                        Terminal komutu çalıştırma yeteneği olan ajanlar için hazır komut satırı arayüzü:
                                    </TextBlock>
                                    <Border Background="#0F172A" CornerRadius="5" Padding="10,8" Margin="0,0,0,6">
                                        <TextBlock Foreground="#FDE047" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                                                   Text="tiagent status&#x0a;tiagent send .\benim_paketim.json&#x0a;tiagent command &quot;DB_V90 veri blogunu sil&quot;&#x0a;tiagent delete -Blocks &quot;DB1,DB2&quot; -ClearMain&#x0a;tiagent gsd &quot;v90&quot;"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- D) Hot-Folder -->
                            <Border Background="White" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="D) Hot-Folder (Inbox / Outbox) — Ağ Erişimi Kısıtlı / Sandbox Ajanlar"
                                               FontWeight="Bold" Foreground="#4F46E5" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap">
                                        Ağ soketlerine erişim izni olmayan izole / sandbox LLM ajanları için:&#x0a;
                                        • İstek: Packages/Inbox/paket.json dosyasına yazılır.&#x0a;
                                        • Yanıt: TIAgent paketi anında işler ve sonucu Packages/Outbox/paket.json.result.json içerisine derleme raporuyla yazar.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- E) Kurallar Tablosu -->
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Projedeki Ajan Kural Dosyaları:" FontWeight="Bold" Foreground="#1E293B" FontSize="12.5" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="#475569" FontSize="12" TextWrapping="Wrap"
                                               Text="• Cursor: .cursorrules  |  • GitHub Copilot: .github/copilot-instructions.md  |  • Claude/OpenCode: CLAUDE.md  |  • Hermes/Aider: CONVENTIONS.md  |  • AI: GEMINI.md"/>
                                </StackPanel>
                            </Border>

