                    <!-- 1. 'KÖPRÜSÜN' AND 'PROGRAMCISIN' COMMANDS (EN) -->
                    <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button x:Name="BtnCopyRolePromptEn"
                                        Content="📋 Copy AI Rules to Clipboard"
                                        Background="#0F766E" Foreground="White" FontWeight="SemiBold"
                                        Padding="12,5" FontSize="12" BorderThickness="0" Cursor="Hand"
                                        DockPanel.Dock="Right" Click="BtnCopyRolePrompt_Click"/>
                                <TextBlock Text="1. 'Köprüsün' (Bridge) and 'Programcısın' (Developer) Commands (Must be defined to AI upfront)"
                                           FontWeight="Bold" Foreground="#166534" FontSize="14.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>

                            <TextBlock Foreground="#1E293B" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10">
                                When collaborating with AI, both TIAgent's own C# source code and TIA Portal PLC automation tasks may reside in the same workspace. To prevent the AI from modifying TIAgent's C# code while writing PLC logic, these two roles should be defined in the workspace GEMINI.md file or at the start of the chat:
                            </TextBlock>

                            <Border Background="White" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="• Definition of 'Köprüsün' (PLC Automation &amp; Ladder Generation Mode)"
                                               FontWeight="Bold" Foreground="#0F766E" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="#334155" FontSize="12.5" TextWrapping="Wrap">
                                        When the user begins a prompt with &quot;Köprüsün&quot; (e.g., &quot;Köprüsün, write a Ladder program for S7-1214 piston pressure test&quot;), AI strictly NEVER modifies or edits TIAgent C# source code (*.cs, *.xaml, *.csproj). It only prepares I/O Tags, Global/Instance DBs, and SimaticML XML (Ladder / SCL) block packages for the requested PLC scenario and sends them to TIAgent via http://localhost:19520/api/package for direct deployment to TIA Portal.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="White" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="• Definition of 'Programcısın' (TIAgent Software Development Mode)"
                                               FontWeight="Bold" Foreground="#B45309" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="#334155" FontSize="12.5" TextWrapping="Wrap">
                                        When the user begins a prompt with &quot;Programcısın&quot; (e.g., &quot;Programcısın, add a help window to the TIAgent UI&quot;), AI directly develops, refactors, or debugs TIAgent desktop software's own C# / WPF source code (TIAgentMCPServer.csproj), compiles with dotnet build, and restarts the application.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="TxtCopyFeedbackEn" Text="" Foreground="#15803D" FontWeight="SemiBold" FontSize="12" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. SIEMENS TIA PORTAL OPENNESS DLL REQUIREMENTS (EN) -->
                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="2. Siemens TIA Portal Openness DLLs and Setup Requirements"
                                       FontWeight="Bold" Foreground="#92400E" FontSize="14.5" Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <TextBlock Foreground="#1E293B" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,6">
                                • Licensing &amp; GitHub Policy: In accordance with Siemens copyright and licensing agreements, commercial DLL files such as Siemens.Engineering.dll or Siemens.Engineering.Hmi.dll are never distributed in GitHub repositories.
                            </TextBlock>
                            <TextBlock Foreground="#1E293B" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,8">
                                • Automatic Local DLL Discovery: TIAgent does not require static DLL references at compile time (uses dynamic Reflection). At runtime, it automatically scans installed TIA Portal versions on your PC and loads the appropriate DLLs from C:\Program Files\Siemens\Automation\Portal Vxx\PublicAPI\Vxx\Siemens.Engineering.dll. The &quot;TIA Version&quot; dropdown only lists TIA Portal versions actually installed on your machine.
                            </TextBlock>

                            <Border Background="White" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Checklist for Smooth Connection:"
                                               FontWeight="Bold" Foreground="#92400E" FontSize="12.5" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                        1) Siemens TIA Portal (V14 SP1 – V21) must be installed on your machine with the &quot;TIA Portal Openness&quot; option selected during setup.
                                    </TextBlock>
                                    <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                        2) Your Windows user account must be a member of the &quot;Siemens TIA Openness&quot; local user group. The &quot;Add to Openness Group&quot; button on the main window performs this with administrative privileges (requires Windows sign-out / sign-in on first addition).
                                    </TextBlock>
                                    <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap">
                                        3) When TIAgent connects to TIA Portal for the first time, click &quot;Yes to all&quot; in the Openness security prompt that appears in TIA Portal.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 3. COMMUNICATION ARCHITECTURE BETWEEN TIA PORTAL AND AI (EN) -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="3. Communication Architecture Between TIA Portal and AI"
                                       FontWeight="Bold" Foreground="#0F172A" FontSize="14.5" Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <TextBlock Foreground="#334155" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,8">
                                While running, TIAgent hosts a local HTTP Bridge API server at http://localhost:19520 and monitors the Packages/Inbox hot-folder. AI sends prepared PLC packages to TIAgent through this bridge:
                            </TextBlock>

                            <Border Background="#0F172A" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Foreground="#38BDF8" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="GET  http://localhost:19520/api/status   → Returns connected TIA Portal, open project, active PLC, existing tag/block list, and recent step logs."/>
                                    <TextBlock Foreground="#4ADE80" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="POST http://localhost:19520/api/package  → Deploys PLC I/O Tags, Global/Instance DBs, and SimaticML XML (LAD/SCL) block packages."/>
                                    <TextBlock Foreground="#FBBF24" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                               Text="POST http://localhost:19520/api/command  → Dispatches block/tag deletion, compilation, approval, or project inspection commands."/>
                                </StackPanel>
                            </Border>

                            <TextBlock Foreground="#0F172A" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"
                                       Text="Execution Modes (Wait for Approval vs No Approval):"/>
                            <TextBlock Foreground="#334155" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,4">
                                • Wait for Approval (Onay Bekle): Incoming packages and delete commands from AI are not applied immediately; they enter the approval bar at the bottom of the main window. You can inspect generated Ladder networks and tag addresses via &quot;View Schema / Tags&quot;, and click &quot;Accept&quot; to apply and compile them in TIA Portal.
                            </TextBlock>
                            <TextBlock Foreground="#334155" FontSize="12.5" TextWrapping="Wrap">
                                • No Approval (Onay Bekleme): Incoming packages from AI are applied directly to TIA Portal without confirmation, existing blocks are backed up to the Backups/ directory, and PLC software is automatically compiled.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 4. HARDWARE AND TECHNOLOGY OBJECT BRIDGE (EN) -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,8,0,6">
                        <StackPanel>
                            <TextBlock Text="4. Hardware (Devices &amp; Networks) and Technology Object Instructions"
                                       FontWeight="Bold" Foreground="#1E3A8A" FontSize="14.5" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBlock Foreground="#1E293B" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,6">
                                Bridge packages (POST /api/package) can carry hardware instructions in addition to software blocks. TIAgent applies these BEFORE compiling logic blocks, allowing blocks like MC_Power / MC_MoveAbsolute to connect directly to newly created axes.
                            </TextBlock>
                            <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                • HardwareDevices: PROFINET device addition (SINAMICS V90 / G120 / S210, ET200SP, or any GSDML-installed device). Configures name, IP address, PROFINET device name, PLC IO-System connection, and telegram / module insertion.
                            </TextBlock>
                            <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                • PlcModules: Inserts SM / CM / SB modules into PLC racks and assigns I/Q start addresses. Sets PLC IP address via PlcIpAddress.
                            </TextBlock>
                            <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                • TechnologyObjects: Generates TO_PositioningAxis, TO_SpeedAxis, TO_SynchronousAxis, TO_ExternalEncoder, PID_Compact, PID_3Step, PID_Temp; connects to drive telegrams and sets parameters.
                            </TextBlock>
                            <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8">
                                • DevicesToDelete / TechnologyObjectsToDelete: Deletes devices, modules, and TOs (&quot;*&quot; = all except the target PLC).
                            </TextBlock>
                            <Border Background="#0F172A" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Foreground="#38BDF8" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="GET  http://localhost:19520/api/hardware  → Lists project devices, modules, IP addresses, and Technology Objects."/>
                                    <TextBlock Foreground="#4ADE80" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                               Text="GET  http://localhost:19520/api/gsd?q=v90  → Lists installed GSDML files, DAP, and telegram/module TypeIdentifiers in TIA Portal."/>
                                </StackPanel>
                            </Border>
                            <TextBlock Foreground="#92400E" FontSize="12" TextWrapping="Wrap">
                                Note: Target devices must exist in the TIA Portal hardware catalog. For GSDML devices, install the respective GSDML file in TIA Portal via &quot;Options → Manage general station description files (GSD)&quot; beforehand (e.g., SINAMICS V90 PN GSDML). TIAgent automatically matches installed files using GsdKeyword.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 5. MULTI-AI AGENT PROTOCOLS (EN) -->
                    <Border Background="#F8FAFC" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="8" Padding="16,14" Margin="0,8,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button x:Name="BtnCopyAgentProtocolsEn"
                                        Content="📋 Copy Multi-Agent Setup Guide to Clipboard"
                                        Background="#0284C7" Foreground="White" FontWeight="SemiBold"
                                        Padding="12,5" FontSize="12" BorderThickness="0" Cursor="Hand"
                                        DockPanel.Dock="Right" Click="BtnCopyAgentProtocols_Click"/>
                                <TextBlock Text="5. Multi-Agent Protocols (Cursor, Copilot, OpenCode, Hermes, Claude Code)"
                                           FontWeight="Bold" Foreground="#0369A1" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>

                            <TextBlock Foreground="#334155" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10">
                                TIAgent MCP Server is engineered to communicate seamlessly through standard protocols not just with a single AI, but with all modern LLM agents used by developers:
                            </TextBlock>

                            <!-- A) MCP -->
                            <Border Background="White" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="A) Model Context Protocol (MCP) — Cursor, VS Code / GitHub Copilot, Cline, Roo Code, Claude"
                                               FontWeight="Bold" Foreground="#0284C7" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6">
                                        The tiagent_mcp.py script at the project root runs a standard Model Context Protocol (JSON-RPC 2.0 stdio) server with zero external dependencies (pure Python standard library). Cursor or VS Code runs this script to discover TIAgent tools as native agent functions:
                                    </TextBlock>
                                    <Border Background="#0F172A" CornerRadius="5" Padding="10,8" Margin="0,0,0,6">
                                        <TextBlock Foreground="#38BDF8" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                                                   Text="• tiagent_status()         → Returns TIA Portal connection, PLC name, and compilation logs.&#x0a;• tiagent_import_package() → Deploys LAD (SimaticML XML), SCL, DB, Tag, and hardware packages to TIA.&#x0a;• tiagent_send_command()   → Dispatches natural language commands (e.g. 'delete DB_V90 data block').&#x0a;• tiagent_delete()         → Cleans blocks, tag tables, or devices from project.&#x0a;• tiagent_search_gsd()     → Searches drive/module catalog in TIA Portal GSDML repository."/>
                                    </Border>
                                    <TextBlock Foreground="#475569" FontSize="11.5" TextWrapping="Wrap"
                                               Text="Configuration Files: .cursor/mcp.json for Cursor and .vscode/mcp.json for VS Code / Copilot are pre-configured in your workspace."/>
                                </StackPanel>
                            </Border>

                            <!-- B) OpenAPI / Swagger -->
                            <Border Background="White" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="B) OpenAPI 3.0 / Swagger — Hermes (Nous Hermes), LangChain, AutoGen, CrewAI, Custom GPTs"
                                               FontWeight="Bold" Foreground="#0D9488" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6">
                                        The TIAgent HTTP server serves a live OpenAPI 3.0 specification. LangChain, AutoGen, CrewAI, or open-source Hermes models can import TIAgent tools with a single line via this endpoint:
                                    </TextBlock>
                                    <Border Background="#0F172A" CornerRadius="5" Padding="10,8" Margin="0,0,0,6">
                                        <TextBlock Foreground="#4ADE80" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                                                   Text="GET http://localhost:19520/swagger.json  or  http://localhost:19520/openapi.json&#x0a;Full CORS enabled (Access-Control-Allow-Origin: * and OPTIONS 204 preflight)."/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- C) CLI -->
                            <Border Background="White" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="C) One-Line CLI (tiagent.bat &amp; tiagent.ps1) — OpenCode, Aider, and Terminal Agents"
                                               FontWeight="Bold" Foreground="#D97706" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6">
                                        A ready-to-use command line interface for agents capable of executing terminal commands:
                                    </TextBlock>
                                    <Border Background="#0F172A" CornerRadius="5" Padding="10,8" Margin="0,0,0,6">
                                        <TextBlock Foreground="#FDE047" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                                                   Text="tiagent status&#x0a;tiagent send .\my_package.json&#x0a;tiagent command &quot;delete DB_V90 data block&quot;&#x0a;tiagent delete -Blocks &quot;DB1,DB2&quot; -ClearMain&#x0a;tiagent gsd &quot;v90&quot;"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- D) Hot-Folder -->
                            <Border Background="White" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="D) Hot-Folder (Inbox / Outbox) — Network-Restricted / Sandboxed Agents"
                                               FontWeight="Bold" Foreground="#4F46E5" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="#334155" FontSize="12" TextWrapping="Wrap">
                                        For isolated or sandboxed LLM agents without raw network socket permissions:&#x0a;
                                        • Request: Written to Packages/Inbox/package.json.&#x0a;
                                        • Response: TIAgent processes immediately and writes compilation results to Packages/Outbox/package.json.result.json.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- E) Rules Table -->
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Agent Rule Files in the Project:" FontWeight="Bold" Foreground="#1E293B" FontSize="12.5" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="#475569" FontSize="12" TextWrapping="Wrap"
                                               Text="• Cursor: .cursorrules  |  • GitHub Copilot: .github/copilot-instructions.md  |  • Claude/OpenCode: CLAUDE.md  |  • Hermes/Aider: CONVENTIONS.md  |  • AI: GEMINI.md"/>
                                </StackPanel>
                            </Border>

