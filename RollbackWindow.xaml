<Window x:Class="TIAgent.RollbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TIAgent — İşlem Geçmişi &amp; Geri Alma (Rollback Center)"
        Width="920" Height="600"
        MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#111A24"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Inter, -apple-system, sans-serif">

    <Window.Resources>
        <!-- Amber / Orange Action Button (Geri Al) -->
        <Style x:Key="RollbackActionButton" TargetType="Button">
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B45309"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FCD34D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Red Button (Yedekleri Temizle) -->
        <Style x:Key="DangerRedButton" TargetType="Button">
            <Setter Property="Background" Value="#5B191F"/>
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7F1D1D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Slate Tool Button -->
        <Style x:Key="SlateToolButton" TargetType="Button">
            <Setter Property="Background" Value="#1E2B3A"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#2F4257"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#293A4E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0C131B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#0F1722"/>
            <Setter Property="AlternatingRowBackground" Value="#121D2B"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1E2B3A"/>
            <Setter Property="VerticalGridLinesBrush" Value="#1E2B3A"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#182535"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#26374A"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header & Action Buttons Strip -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Operations List (DataGrid) -->
            <RowDefinition Height="*"/>
            <!-- 2: Bottom Status & Close Strip -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0: TOP HEADER & ACTIONS -->
        <Border Grid.Row="0" Background="#16222F" BorderBrush="#233245" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <!-- Sol: Başlık ve Açıklama -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Background="#D97706" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="↺" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="LblWindowTitle" Text="İşlem Geçmişi &amp; Geri Alma Merkezi" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="LblWindowSubtitle" Text="Zaman ve işlem bazlı yedekler listelenir. 'Geri Al' ile TIA Portal'daki bloklar işlem öncesine döndürülür." Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Sağ: Yenile & Yedekleri Temizle -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <Button x:Name="BtnRefresh" Style="{StaticResource SlateToolButton}" Content="🔄 Yenile" Margin="0,0,8,0"
                            Click="BtnRefresh_Click"/>
                    <Button x:Name="BtnClearAllBackups" Style="{StaticResource DangerRedButton}" Content="🗑️ Tüm Yedekleri Temizle"
                            Click="BtnClearAllBackups_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 1: OPERATIONS LIST (DATAGRID) -->
        <Border Grid.Row="1" Background="#0C131B" Margin="12,10,12,6" BorderBrush="#26374A" BorderThickness="1" CornerRadius="5">
            <DataGrid x:Name="DgOperations" AutoGenerateColumns="False" IsReadOnly="True"
                      RowHeight="36" FontSize="11.5" SelectionMode="Single"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <!-- Zaman Damgası -->
                    <DataGridTemplateColumn x:Name="ColTimestamp" Header="ZAMAN" Width="135">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Timestamp}" Foreground="#94A3B8" FontFamily="Consolas" VerticalAlignment="Center" Padding="8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- İşlem / Paket Adı -->
                    <DataGridTemplateColumn x:Name="ColOpName" Header="İŞLEM ADI" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OperationName}" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" Padding="6,0" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Talep / Komut -->
                    <DataGridTemplateColumn x:Name="ColPrompt" Header="KOMUT / TALEP" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Prompt}" Foreground="#F8FAFC" VerticalAlignment="Center" Padding="6,0" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Etkilenen / Yedeklenen Bloklar -->
                    <DataGridTemplateColumn x:Name="ColSummary" Header="BLOK BİLGİSİ" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplaySummary}" Foreground="#94A3B8" FontSize="10.5" VerticalAlignment="Center" Padding="6,0" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Durum Rozeti -->
                    <DataGridTemplateColumn x:Name="ColStatus" Header="DURUM" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusColor}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Geri Al Butonu -->
                    <DataGridTemplateColumn x:Name="ColAction" Header="EYLEM" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding RollbackButtonText}" Style="{StaticResource RollbackActionButton}"
                                        Margin="4,2" Click="BtnRollbackItem_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 2: BOTTOM STATUS & CLOSE STRIP -->
        <Border Grid.Row="2" Background="#16222F" BorderBrush="#233245" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TxtStatus" Text="Yedek kayıtları taranıyor..." Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Button x:Name="BtnClose" Style="{StaticResource SlateToolButton}" Content="Kapat" Width="90" DockPanel.Dock="Right"
                        Click="BtnClose_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>