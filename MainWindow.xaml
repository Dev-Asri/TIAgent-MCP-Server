<Window x:Class="TIAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TIAgent MCP Server - asriakdeniz@gmail.com"
        Width="520" Height="540"
        MinWidth="120" MinHeight="180"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="PrimaryTealButton" TargetType="Button">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#115E59"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetChipButton" TargetType="Button">
            <Setter Property="Background" Value="#F0FDF4"/>
            <Setter Property="Foreground" Value="#166534"/>
            <Setter Property="BorderBrush" Value="#BBF7D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCFCE7"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#86EFAC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Dark Navy Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Connection & Openness Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Import Mode, PLC & Folder Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Main Tabs (Adımlar, Paket & Ladder Önizleme, Proje Gezgini, Kayıt, İzinler) -->
            <RowDefinition Height="*"/>
            <!-- 4: Bottom Approval Panel (onay – Paketi aktar) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 0. TOP DARK NAVY HEADER ==================== -->
        <Border Grid.Row="0" Background="#1E293B" Padding="12,8" ClipToBounds="True">
            <DockPanel LastChildFill="False">
                <!-- Sol: TIA Sürüm Bilgisi ve Yardım Butonu Sola Kaydırıldı -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock x:Name="LblTiaVersion" Text="TIA Sürümü:" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbVersion" Width="145" Height="25" FontSize="12" Margin="0,0,10,0"
                              SelectionChanged="CmbVersion_SelectionChanged"/>
                    <Button x:Name="BtnHeaderHelp" Style="{StaticResource PrimaryTealButton}"
                            Content="? Yardım &amp; Hakkında" Padding="10,4" FontSize="11.5"
                            Click="BtnHeaderHelp_Click"/>
                </StackPanel>

                <!-- Sağ: Dil Seçimi (Türkçe & English) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <TextBlock x:Name="LblLanguage" Text="Dil:" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbLanguage" Width="120" Height="25" FontSize="12"
                              SelectionChanged="CmbLanguage_SelectionChanged">
                        <ComboBoxItem x:Name="CmbItemTr" Content="🇹🇷 Türkçe" Tag="tr" IsSelected="True"/>
                        <ComboBoxItem x:Name="CmbItemEn" Content="En English" Tag="en"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== 1. CONNECTION, PLC/FOLDER & ACTION BAR ==================== -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,7" ClipToBounds="True">
            <StackPanel ClipToBounds="True">
                <Grid Margin="0,0,0,3" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblAiBridge" Text="AI Köprü:" Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DotAiStatus" Width="8" Height="8" Fill="#16A34A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtAiStatus" Text="Bağlı — AI Köprüsü Aktif (localhost:19520)"
                                   Foreground="#15803D" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,7" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblTia" Text="TIA:" Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DotTiaStatus" Width="8" Height="8" Fill="#D97706" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTiaStatus" Text="Taranıyor..."
                                   Foreground="#B45309" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: TIA'ya bağlan / yenile + PLC + Klasör -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                    <Button x:Name="BtnConnectTia" Style="{StaticResource PrimaryTealButton}"
                            Content="TIA'ya bağlan / yenile" Padding="12,5" Margin="0,0,10,0"
                            Click="BtnConnectTia_Click"/>

                    <TextBlock x:Name="LblPlc" Text="PLC:" Foreground="#475569" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="CmbPlc" Width="125" Height="25" FontSize="12" Margin="0,0,10,0"
                              SelectionChanged="CmbPlc_SelectionChanged"/>

                    <TextBlock x:Name="LblFolder" Text="Klasör:" Foreground="#475569" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtTargetFolder" Width="105" Height="25" VerticalContentAlignment="Center"
                             FontSize="12" Padding="5,0" BorderBrush="#CBD5E1"
                             ToolTip="Boş bırakılırsa Program blocks köküne eklenir. İç içe klasör örneği: Motorlar/Hat1"/>
                </StackPanel>

                <!-- Row 2: Action Buttons (Left-Aligned) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnOpenProjectFile" Style="{StaticResource OutlineButton}"
                            Content="Kapalı Proje Aç (.ap*)" Padding="9,4" Margin="0,0,5,0"
                            Click="BtnOpenProjectFile_Click"/>
                    <Button x:Name="BtnAddOpennessGroup" Style="{StaticResource OutlineButton}"
                            Content="Openness grubuna ekle" Padding="9,4" Margin="0,0,5,0"
                            Click="BtnAddOpennessGroup_Click"/>
                    <Button x:Name="BtnBackupFolder" Style="{StaticResource OutlineButton}"
                            Content="Yedek klasörü" Padding="9,4" Margin="0,0,5,0"
                            Click="BtnBackupFolder_Click"/>
                    <Button x:Name="BtnReadProject" Style="{StaticResource OutlineButton}"
                            Content="Projeyi Oku" Padding="9,4"
                            Click="BtnReadProject_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================== 2. IMPORT MODE BAR ==================== -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,5" ClipToBounds="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="RbImportManual" Content="Onay Bekle" IsChecked="True"
                             VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12"
                             Checked="RbImportMode_Changed"/>
                <RadioButton x:Name="RbImportAuto" Content="Onay Bekleme"
                             VerticalAlignment="Center" FontSize="12"
                             Checked="RbImportMode_Changed"/>
            </StackPanel>
        </Border>

        <!-- ==================== 3. MAIN TABS ==================== -->
        <TabControl x:Name="MainTabs" Grid.Row="3" Margin="8,5,8,5" BorderBrush="#CBD5E1" Background="White" ClipToBounds="True">

            <!-- TAB 1: ADIMLAR (Exactly like Screenshot + Clear & Copyable!) -->
            <TabItem x:Name="TabSteps" Header="  Adımlar  " FontSize="12">
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Adımlar Toolbar: Temizle & Kopyala -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,4" ClipToBounds="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnClearSteps" Style="{StaticResource OutlineButton}"
                                    Content="🗑 Adımları Temizle" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                    Click="BtnClearSteps_Click"/>
                            <Button x:Name="BtnCopySelectedSteps" Style="{StaticResource OutlineButton}"
                                    Content="📋 Seçileni Kopyala" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                    Click="BtnCopySelectedSteps_Click"/>
                            <Button x:Name="BtnCopyAllSteps" Style="{StaticResource OutlineButton}"
                                    Content="📋 Tümünü Kopyala" Padding="8,3" FontSize="11" Margin="0,0,8,0"
                                    Click="BtnCopyAllSteps_Click"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="DgSteps" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9" Background="White"
                              BorderThickness="0" RowHeight="26" FontSize="11.5"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              ClipboardCopyMode="ExcludeHeader">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📋 Seçili Satırları Kopyala (Ctrl+C)" Click="BtnCopySelectedSteps_Click"/>
                                <MenuItem Header="📋 Tüm Adımları Kopyala" Click="BtnCopyAllSteps_Click"/>
                                <Separator/>
                                <MenuItem Header="🗑 Adımları Temizle" Click="BtnClearSteps_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Saat" Width="68" ClipboardContentBinding="{Binding Time}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Time, Mode=OneWay}" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent" Foreground="#64748B"
                                                 VerticalContentAlignment="Center" Padding="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="28" ClipboardContentBinding="{Binding Icon}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Icon}" Foreground="{Binding IconColor}"
                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="İş" Width="*" ClipboardContentBinding="{Binding JobText}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding JobText, Mode=OneWay}" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent" Foreground="#1E293B"
                                                 VerticalContentAlignment="Center" Padding="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: PAKET & LADDER ŞEMASI ÖNİZLEME -->
            <TabItem x:Name="TabPreview" Header="  Paket &amp; Ladder Önizleme  " FontSize="12">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: PLC Tags & Data Blocks in Package -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="130"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="LblPackageTags" Grid.Row="0" Text="1. Oluşturulacak PLC I/O Tagları (Düzenlenebilir)"
                                   FontWeight="SemiBold" Foreground="#0F766E" FontSize="12" Margin="0,0,0,4"/>
                        <DataGrid x:Name="DgPackageTags" Grid.Row="1" AutoGenerateColumns="False"
                                  CanUserAddRows="True" GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0"
                                  FontSize="11.5" RowHeight="24">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tag Adı" Binding="{Binding Name}" Width="125"/>
                                <DataGridTextColumn Header="Adres" Binding="{Binding LogicalAddress}" Width="58"/>
                                <DataGridTextColumn Header="Tip" Binding="{Binding DataType}" Width="48"/>
                                <DataGridTextColumn Header="Açıklama" Binding="{Binding Comment}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="LblPackageDbs" Grid.Row="2" Text="2. Oluşturulacak Veri Blokları (DB)"
                                   FontWeight="SemiBold" Foreground="#0F766E" FontSize="12" Margin="0,8,0,4"/>
                        <ListBox x:Name="LstPackageDbs" Grid.Row="3" FontSize="11.5" BorderBrush="#CBD5E1"/>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#F1F5F9"/>

                    <!-- Right: Visual Ladder Networks, SCL Code & SimaticML XML -->
                    <TabControl Grid.Column="2" BorderBrush="#E2E8F0">
                        <TabItem x:Name="TabSubVisual" Header="Grafiksel Ladder Networkler">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                                <ItemsControl x:Name="IcVisualNetworks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                                                    CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1"
                                                                CornerRadius="3" Padding="6,1" Margin="0,0,8,0" DockPanel.Dock="Left">
                                                            <TextBlock Text="{Binding Language}" Foreground="#166534" FontWeight="Bold" FontSize="11"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="12.5"/>
                                                    </DockPanel>
                                                    <Border Background="#0F172A" CornerRadius="4" Padding="10,8" Margin="0,2,0,4">
                                                        <TextBlock Text="{Binding AsciiLadderDiagram}" FontFamily="Consolas"
                                                                   Foreground="#38BDF8" FontSize="12" TextWrapping="Wrap"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding SclPreview}" FontFamily="Consolas"
                                                               Foreground="#475569" FontSize="11.5" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="TabSubScl" Header="SCL Kaynak Kodu">
                            <TextBox x:Name="TxtPackageSclPreview" FontFamily="Consolas" FontSize="12"
                                     IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" Padding="8"/>
                        </TabItem>
                        <TabItem x:Name="TabSubXml" Header="SimaticML XML (TIA Import)">
                            <TextBox x:Name="TxtPackageXmlPreview" FontFamily="Consolas" FontSize="11.5"
                                     IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" Padding="8"/>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <!-- TAB 3: PROJE GEZGİNİ (Mevcut PLC Tag & Bloklar) -->
            <TabItem x:Name="TabExplorer" Header="  Proje Gezgini  " FontSize="12.5">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox x:Name="GrpExistingTags" Grid.Column="0" Header="PLC'deki Mevcut Taglar">
                        <DataGrid x:Name="DgExistingTags" AutoGenerateColumns="False" IsReadOnly="True"
                                  FontSize="11.5" RowHeight="24" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tablo" Binding="{Binding TableName}" Width="110"/>
                                <DataGridTextColumn Header="Tag Adı" Binding="{Binding Name}" Width="130"/>
                                <DataGridTextColumn Header="Adres" Binding="{Binding LogicalAddress}" Width="65"/>
                                <DataGridTextColumn Header="Tip" Binding="{Binding DataType}" Width="55"/>
                                <DataGridTextColumn Header="Açıklama" Binding="{Binding Comment}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox x:Name="GrpExistingBlocks" Grid.Column="2" Header="PLC'deki Mevcut Program Blokları (OB / FB / FC)">
                        <DataGrid x:Name="DgExistingBlocks" AutoGenerateColumns="False" IsReadOnly="True"
                                  FontSize="11.5" RowHeight="24" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tip" Binding="{Binding BlockType}" Width="48"/>
                                <DataGridTextColumn Header="Blok Adı" Binding="{Binding Name}" Width="155"/>
                                <DataGridTextColumn Header="Dil" Binding="{Binding ProgrammingLanguage}" Width="55"/>
                                <DataGridTextColumn Header="Klasör Yolu" Binding="{Binding GroupPath}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- TAB 4: KAYIT (Detailed Log) -->
            <TabItem x:Name="TabLog" Header="  Kayıt  " FontSize="12.5">
                <TextBox x:Name="TxtDetailedLog" FontFamily="Consolas" FontSize="12"
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="#0F172A" Foreground="#E2E8F0" Padding="10" BorderThickness="0"/>
            </TabItem>

            <!-- TAB 5: İZİNLER (Openness Group & Whitelist & Bridge) -->
            <TabItem x:Name="TabPermissions" Header="  İzinler  " FontSize="12">
                <StackPanel Margin="16">
                    <TextBlock x:Name="LblPermissionsTitle" Text="Siemens TIA Openness &amp; AI Köprü İzinleri"
                               FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <TextBlock x:Name="TxtPermissionsInfo" FontFamily="Consolas" FontSize="12.5" Foreground="#334155" TextWrapping="Wrap"/>
                    </Border>
                    <WrapPanel>
                        <Button x:Name="BtnAddOpennessGroupAdmin" Style="{StaticResource PrimaryTealButton}" Content="Kullanıcıyı Openness Grubuna &amp; Whitelist'e Ekle (Yönetici)"
                                Click="BtnAddOpennessGroup_Click" Margin="0,0,10,0"/>
                        <Button x:Name="BtnRefreshPermissions" Style="{StaticResource OutlineButton}" Content="İzin Durumunu Yenile"
                                Click="BtnRefreshPermissions_Click"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- ==================== 4. BOTTOM APPROVAL PANEL ==================== -->
        <Border x:Name="PanelApproval" Grid.Row="4" Background="White" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12,7" ClipToBounds="True">
            <StackPanel ClipToBounds="True">
                <!-- Header line: onay – Paketi aktar -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="▣" Foreground="#B45309" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <TextBox x:Name="TxtApprovalHeader" Grid.Column="1"
                             Text="onay – Hazır paket bekleniyor (AI üzerinden gönderilen işlemler burada onaylanır)"
                             Foreground="#B45309" FontWeight="SemiBold" FontSize="12" VerticalContentAlignment="Center"
                             IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                </Grid>

                <!-- Details Box -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6" MaxHeight="72">
                    <TextBox x:Name="TxtApprovalDetails" FontFamily="Consolas" FontSize="11.5" Foreground="#1E293B"
                             IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="Paket: -&#x0a;Hedef: -&#x0a;İçerik: Henüz onay bekleyen bir paket yok."/>
                </Border>

                <!-- Action Controls & Countdown -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnApprovePackage" Style="{StaticResource PrimaryTealButton}"
                                Content="Kabul Et" Width="95" Margin="0,0,8,0" IsEnabled="False"
                                Click="BtnApprovePackage_Click"/>
                        <Button x:Name="BtnRejectPackage" Style="{StaticResource OutlineButton}"
                                Content="İptal Et" Width="78" Margin="0,0,8,0" IsEnabled="False"
                                Click="BtnRejectPackage_Click"/>
                        <Button x:Name="BtnShowPreviewTab" Style="{StaticResource OutlineButton}"
                                Content="Şemayı / Tagları Gör"
                                Click="BtnShowPreviewTab_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtCountdown" Grid.Column="2"
                               Text=""
                               Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>

