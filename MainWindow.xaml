<Window x:Class="TIAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TIAgent MCP Server"
        Width="860" Height="730"
        MinWidth="320" MinHeight="250"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindow}"
        Foreground="{DynamicResource TextMain}"
        FontFamily="Segoe UI, Inter, -apple-system, sans-serif">

    <Window.Resources>
        <!-- Dynamic Theme Color Brushes (Varsayılan Açık Tema) -->
        <SolidColorBrush x:Key="BgWindow" Color="#EAEEF4"/>
        <SolidColorBrush x:Key="BgHeader" Color="#DEE4EC"/>
        <SolidColorBrush x:Key="BgSubHeader" Color="#D5DCE6"/>
        <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgSubCard" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BgBox" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderCard" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="BorderHeader" Color="#B0BFD0"/>
        <SolidColorBrush x:Key="TextMain" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="TextConsole" Color="#0369A1"/>
        <SolidColorBrush x:Key="DgBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DgRowBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DgAltRowBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="DgHeaderBg" Color="#EEF2F6"/>
        <SolidColorBrush x:Key="DgGridLines" Color="#E2E8F0"/>

        <!-- Dynamic Button Theme Color Brushes -->
        <SolidColorBrush x:Key="BtnToolBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BtnToolFg" Color="#1E293B"/>
        <SolidColorBrush x:Key="BtnToolBorder" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BtnToolHoverBg" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="BtnToolHoverFg" Color="#0284C7"/>
        <SolidColorBrush x:Key="BtnToolHoverBorder" Color="#0284C7"/>

        <SolidColorBrush x:Key="BtnDangerBg" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="BtnDangerFg" Color="#991B1B"/>
        <SolidColorBrush x:Key="BtnDangerBorder" Color="#EF4444"/>
        <SolidColorBrush x:Key="BtnDangerHoverBg" Color="#FECDCD"/>

        <SolidColorBrush x:Key="BtnMiniBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BtnMiniFg" Color="#334155"/>
        <SolidColorBrush x:Key="BtnMiniBorder" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="BtnMiniHoverBg" Color="#E2E8F0"/>

        <!-- Blue Accent Action Button (Bağlan) -->
        <Style x:Key="PrimaryBlueButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0369A1"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7DD3FC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Açık Mavi Action Button (PLC'ye Aktar) -->
        <Style x:Key="LightBlueActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7DD3FC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kırmızı Action Button (İptal Et) -->
        <Style x:Key="RejectRedButton" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#F87171"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B91C1C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FCA5A5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green Action Button (Kabul Et) -->
        <Style x:Key="SuccessGreenButton" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#34D399"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#047857"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6EE7B7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red Disconnect / Cancel Button (Bağlantıyı Kes / İptal Et) -->
        <Style x:Key="DangerRedButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnDangerBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnDangerFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnDangerBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnDangerHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tool Button (Yenile, Kapalı Proje Aç, vb.) -->
        <Style x:Key="SlateToolButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnToolBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnToolFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnToolBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnToolHoverBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BtnToolHoverBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BtnToolHoverFg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header Mini Theme Button (Açık / Koyu) -->
        <Style x:Key="MiniThemeButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnMiniBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnMiniFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnMiniBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnMiniHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgBox}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- ComboBox Style (Koyu ve Açık temada okunur SİYAH yazı + BEYAZ zemin) -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- Dark RadioButton Style -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- DataGrid Style (Temaya Göre Dinamik: Açık temada BEYAZ, Koyu temada KOYU) -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource DgBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="{DynamicResource DgRowBg}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource DgAltRowBg}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DgGridLines}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DgGridLines}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource DgHeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DgGridLines}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <!-- Boxed / Folder TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Tab Headers Strip -->
                            <Border Grid.Row="0" Background="{DynamicResource BgHeader}" BorderBrush="{DynamicResource BorderHeader}" BorderThickness="0,0,0,1" Padding="8,6,8,0">
                                <TabPanel IsItemsHost="True" VerticalAlignment="Bottom"/>
                            </Border>
                            <!-- Tab Content Area -->
                            <Border Grid.Row="1" Background="{DynamicResource BgSubHeader}" BorderBrush="{DynamicResource BorderHeader}" BorderThickness="0,0,0,1">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boxed / Folder TabItem Style (Kutu / Belirgin Tab Sayfası Şeklinde) -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource BgBox}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{DynamicResource BgBox}"
                                BorderBrush="{DynamicResource BorderCard}"
                                BorderThickness="1,1,1,1"
                                Margin="0,0,6,-1"
                                CornerRadius="5,5,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgSubCard}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgSubHeader}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5,2.5,1.5,0"/>
                                <Setter Property="Foreground" Value="#0284C7"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Top Window Title Strip -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Upper Section TabControl (Bağlantı, Onay, Hızlı İşlemler, Tema & Dil) -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Main Workspace (Approval Card + 2 Logs; extends full width!) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 0. TOP TITLE STRIP ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource BgHeader}" BorderBrush="{DynamicResource BorderHeader}" BorderThickness="0,0,0,1" Padding="12,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#0284C7" CornerRadius="4" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="⚡" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="TIAgent MCP Server" Foreground="{DynamicResource TextMain}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ==================== 1. UPPER SECTION TABS ==================== -->
        <TabControl Grid.Row="1" x:Name="MainTabControl">
            <!-- 1. BAĞLANTI (CONNECTION) -->
            <TabItem x:Name="TabItemConnection" Header="🔗 Bağlantı">
                <Border Background="{DynamicResource BgSubHeader}" Padding="14,10">
                    <StackPanel Orientation="Vertical">
                        <!-- 1. TIA Sürümü Satırı -->
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock x:Name="LblTiaVersion" Text="TIA Sürümü:" Width="90" Foreground="{DynamicResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbVersion" Width="180" Height="25" FontSize="11.5" Margin="0,0,10,0"
                                      SelectionChanged="CmbVersion_SelectionChanged"/>
                        </WrapPanel>

                        <!-- 2. Açık Projeler Satırı (Yenile butonu yanında) -->
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock x:Name="LblOpenProjects" Text="Açık Projeler:" Width="90" Foreground="{DynamicResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbProjects" Width="180" Height="25" FontSize="11.5" Margin="0,0,8,0"
                                      SelectionChanged="CmbProjects_SelectionChanged"/>
                            <Button x:Name="BtnRefreshTia" Style="{StaticResource SlateToolButton}" Content="🔄 Yenile" Padding="12,3" Margin="0,0,6,0"
                                    Click="BtnConnectTia_Click"/>
                        </WrapPanel>

                        <!-- 3. PLC İstasyonu Satırı (Bağlan yanında) -->
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock x:Name="LblPlc" Text="PLC İstasyonu:" Width="90" Foreground="{DynamicResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbPlc" Width="180" Height="25" FontSize="11.5" Margin="0,0,8,0"
                                      SelectionChanged="CmbPlc_SelectionChanged"/>
                            <Button x:Name="BtnConnectTia" Style="{StaticResource PrimaryBlueButton}" Content="🔌 Bağlan" Padding="14,3" Margin="0,0,6,0"
                                    Click="BtnConnectTia_Click"/>
                        </WrapPanel>

                        <!-- 4. PLC İstasyonunun Altındaki Butonlar (Bağlantıyı Kes, Kapalı Proje Aç, Yeniden Başlat) -->
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="96,0,0,10">
                            <Button x:Name="BtnDisconnectTia" Style="{StaticResource DangerRedButton}" Content="✂️ Bağlantıyı Kes" Padding="10,3" Margin="0,0,6,0"
                                    Click="BtnDisconnectTia_Click"/>
                            <Button x:Name="BtnOpenProjectFile" Style="{StaticResource SlateToolButton}" Content="📂 Kapalı Proje Aç (.apXX)" Padding="10,3" Margin="0,0,6,0"
                                    Click="BtnOpenProjectFile_Click"/>
                            <Button x:Name="BtnRestartApp" Style="{StaticResource SlateToolButton}" Content="🔁 Yeniden Başlat" Padding="8,3" Margin="0,0,0,0"
                                    Click="BtnRestartApp_Click"/>
                        </WrapPanel>

                        <Separator Background="{DynamicResource BorderCard}" Margin="0,0,0,8"/>

                        <!-- 5. AI Köprüsü Satırı (Bağlı:... satırının ÜSTÜNDE) -->
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock x:Name="LblAiBridge" Text="AI Köprüsü:" Width="90" Foreground="{DynamicResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Ellipse x:Name="DotAiStatus" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAiStatus" Text="localhost:19520 (Aktif)" Foreground="#34D399" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button x:Name="BtnToggleBridge" Style="{StaticResource SlateToolButton}" Content="🟢 Köprü Açık" Padding="8,2" FontSize="11"
                                    Click="BtnToggleBridge_Click"/>
                        </WrapPanel>

                        <!-- 6. TIA Bağlantı Durumu Satırı (Bağlı: Otomasyon Hat Projesi...) -->
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Durum:" Width="90" Foreground="{DynamicResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Ellipse x:Name="DotTiaStatus" Width="8" Height="8" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTiaStatus" Text="Bağlantı bekleniyor... | Aktif Proje: - |"
                                       Foreground="{DynamicResource TextMuted}" FontSize="11.5" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 2. ONAY (APPROVAL) -->
            <TabItem x:Name="TabItemApproval" Header="🛡️ Onay">
                <Border Background="{DynamicResource BgSubHeader}" Padding="14,10">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="LblApprovalModeTitle" Visibility="Collapsed"/>
                        <!-- Onay Bekle -->
                        <RadioButton x:Name="RbImportManual" Content="Onay Bekle" IsChecked="True"
                                     Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"
                                     Checked="RbImportMode_Changed" Margin="0,0,0,4"/>
                        <!-- Onay Bekleme (Altında) -->
                        <RadioButton x:Name="RbImportAuto" Content="Onay Bekleme"
                                     Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"
                                     Checked="RbImportMode_Changed" Margin="0,0,0,8"/>
                        <!-- Kısa Açıklama -->
                        <TextBlock x:Name="TxtApprovalExplanation"
                                   Text="Onay Bekle: Paketler PLC'ye Aktar butonu ile işlenir.&#x0a;Onay Bekleme: Onay olmadan otomatik olarak gelen paketler işlenir."
                                   Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="2,0,0,0"/>
                        <TextBlock x:Name="TxtImportManualDesc" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtImportAutoDesc" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 3. HIZLI İŞLEMLER (QUICK ACTIONS) -->
            <TabItem x:Name="TabItemQuickActions" Header="⚡ Hızlı İşlemler">
                <Border Background="{DynamicResource BgSubHeader}" Padding="14,10">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="LblQuickActionsTitle" Visibility="Collapsed"/>
                        <!-- Butonlar Alt Alta -->
                        <Button x:Name="BtnReadProject" Style="{StaticResource SlateToolButton}" Content="🔍 Projeyi Oku"
                                HorizontalAlignment="Left" MinWidth="160" Margin="0,0,0,6" Padding="12,4" FontSize="11.5"
                                Click="BtnReadProject_Click"/>
                        <Button x:Name="BtnAddOpennessGroup" Style="{StaticResource SlateToolButton}" Content="🛡️ Openness Grubu"
                                HorizontalAlignment="Left" MinWidth="160" Margin="0,0,0,6" Padding="12,4" FontSize="11.5"
                                Click="BtnAddOpennessGroup_Click"/>
                        <Button x:Name="BtnOpenRollbackWindow" Style="{StaticResource SlateToolButton}" Content="↺ İşlem Geçmişi"
                                HorizontalAlignment="Left" MinWidth="160" Margin="0,0,0,0" Padding="12,4" FontSize="11.5"
                                Click="BtnOpenRollbackWindow_Click"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 4. TEMA & DİL (THEME & LANGUAGE) -->
            <TabItem x:Name="TabItemThemeLang" Header="🎨 Tema-Dil-Yardım">
                <Border Background="{DynamicResource BgSubHeader}" Padding="14,10">
                    <StackPanel Orientation="Vertical">
                        <!-- Görünüm & Tema: Açık / Koyu Tema & Üstte & Yardım Butonları -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Görünüm &amp; Tema:" Width="120" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button x:Name="BtnThemeLight" Style="{StaticResource MiniThemeButton}" Content="☀️ Açık" Margin="0,0,6,0" Padding="10,4"
                                        Click="BtnThemeLight_Click"/>
                                <Button x:Name="BtnThemeDark" Style="{StaticResource MiniThemeButton}" Content="🌙 Koyu" Margin="0,0,6,0" Padding="10,4"
                                        Click="BtnThemeDark_Click"/>
                                <Button x:Name="BtnToggleTopmost" Style="{StaticResource MiniThemeButton}" Content="📌 Üstte" Margin="0,0,6,0" Padding="10,4"
                                        Click="BtnToggleTopmost_Click"/>
                                <Button x:Name="BtnHeaderHelp" Style="{StaticResource MiniThemeButton}" Content="? Yardım" Margin="0,0,0,0" Padding="10,4"
                                        Click="BtnHeaderHelp_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Arayüz Dili Seçimi (Görünüm & Tema'nın ALTINDA) -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="LblLanguage" Text="Arayüz Dili:" Width="120" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbLanguage" Height="25" Width="135" FontSize="11.5" VerticalAlignment="Center"
                                          SelectionChanged="CmbLanguage_SelectionChanged">
                                    <ComboBoxItem x:Name="CmbItemTr" Content="🇹🇷 Türkçe" Tag="tr" IsSelected="True"/>
                                    <ComboBoxItem x:Name="CmbItemEn" Content="🇬🇧 English" Tag="en"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ==================== 2. MAIN WORKSPACE (FULL WIDTH EXTENDED TO RIGHT) ==================== -->
        <Grid Grid.Row="2" Margin="8,6,8,8">
            <Grid.RowDefinitions>
                <!-- 0: AI TALEP & ONAY KARTI (Kabul Et & İptal Et Butonları) -->
                <RowDefinition Height="Auto"/>
                <!-- 1: İKİ AYRI LOG BÖLÜMÜ (AI Köprüsü Logu + TIAgent İşlem Günlüğü) -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 0: AI TALEP & ONAY KARTI (Kabul Et & İptal Et Butonları) -->
            <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="5" Padding="12,9" Margin="0,0,0,8">
                <StackPanel>
                    <!-- Başlık ve Geri Sayım Rozeti -->
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="LblApprovalBadge" Text="AI'den Gelen Paketler:"
                                       Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtApprovalHeader"
                                     Text="Paket bekleniyor"
                                     Foreground="#FBBF24" FontWeight="Bold" FontSize="12" VerticalContentAlignment="Center"
                                     IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtCountdown" DockPanel.Dock="Right"
                                   Text="" FontFamily="Consolas" FontWeight="Bold"
                                   Foreground="#F87171" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Detay Kutusu (Monospace Cyber-Card) -->
                    <Border Background="{DynamicResource BgBox}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8" MaxHeight="75">
                        <TextBox x:Name="TxtApprovalDetails" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource TextMain}"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="AI Talebi: -&#x0a;PLC Konumu: -&#x0a;İşlem Detayı: Henüz onay bekleyen bir işlem yok.">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="MenuCopyPackage" Header="📋 Kopyala" Click="BtnCopyPackage_Click"/>
                                    <MenuItem x:Name="MenuClearPackage" Header="🗑 Temizle" Click="BtnClearPackage_Click"/>
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                    </Border>

                    <!-- Eylem Butonları: Sol Tarafta PLC'ye Aktar & İptal Et, Sağa Dayalı Temizle & Kopyala -->
                    <DockPanel LastChildFill="False" VerticalAlignment="Center" Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Button x:Name="BtnApprovePackage" Style="{StaticResource LightBlueActionButton}"
                                    Content="✓ PLC'ye Aktar" Margin="0,0,8,0" IsEnabled="False"
                                    Click="BtnApprovePackage_Click"/>

                            <Button x:Name="BtnRejectPackage" Style="{StaticResource RejectRedButton}"
                                    Content="✕ İptal Et" Margin="0,0,0,0" IsEnabled="False"
                                    Click="BtnRejectPackage_Click"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnClearPackage" Style="{StaticResource SlateToolButton}"
                                    Content="🗑 Temizle" Margin="0,0,6,0" Padding="10,4" FontSize="11"
                                    Click="BtnClearPackage_Click"/>

                            <Button x:Name="BtnCopyPackage" Style="{StaticResource SlateToolButton}"
                                    Content="📋 Kopyala" Margin="0,0,0,0" Padding="10,4" FontSize="11"
                                    Click="BtnCopyPackage_Click"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 1: LOG TABCONTROL (HER BİR LOG BİR TAB SAYFASINDA - FORM BOYUNA KADAR GENİŞ) -->
            <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="5" Padding="0">
                <TabControl x:Name="LogTabControl" Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <!-- LOG 1: AI KÖPRÜSÜ İLETİŞİM LOGU -->
                    <TabItem x:Name="TabItemAiLog" Header="🌐 AI Köprüsü Logu">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Başlık ve Temizle / Kopyala Butonları -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblAiLogsTitle" Text="🌐 AI Köprüsü İletişim &amp; Talep Logu" Foreground="#38BDF8" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnClearAiLogs" Style="{StaticResource SlateToolButton}" Content="🗑 Temizle" Padding="8,3" FontSize="11" Margin="0,0,4,0"
                                            Click="BtnClearAiLogs_Click"/>
                                    <Button x:Name="BtnCopyAiLogs" Style="{StaticResource SlateToolButton}" Content="📋 Kopyala" Padding="8,3" FontSize="11"
                                            Click="BtnCopyAiLogs_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- AI Olayları DataGrid (Tüm Genişlik ve Yükseklik) -->
                            <DataGrid x:Name="DgSteps" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                      RowHeight="26" FontSize="11.5" SelectionMode="Extended" SelectionUnit="FullRow"
                                      ClipboardCopyMode="ExcludeHeader" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn x:Name="ColTime" Header="ZAMAN" Width="68" ClipboardContentBinding="{Binding Time}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextMuted}" FontFamily="Consolas" VerticalAlignment="Center" Padding="4,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn x:Name="ColStatus" Header="DURUM" Width="80" ClipboardContentBinding="{Binding Icon}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Icon}" Foreground="{Binding IconColor}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn x:Name="ColDetails" Header="AI TALEP / İŞLEM DETAYI" Width="*" ClipboardContentBinding="{Binding JobText}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding JobText, Mode=OneWay}" IsReadOnly="True"
                                                         BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextMain}"
                                                         FontFamily="Consolas" FontSize="11.5" VerticalContentAlignment="Center" Padding="4,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- LOG 2: TIAGENT & OPENNESS İŞLEM GÜNLÜĞÜ -->
                    <TabItem x:Name="TabItemTiaLog" Header="⚙️ Openness İşlem Günlüğü">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Başlık ve Temizle / Kopyala Butonları -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblTiaLogsTitle" Text="⚙️ TIAgent &amp; Openness İşlem Günlüğü" Foreground="#34D399" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnClearTiaLogs" Style="{StaticResource SlateToolButton}" Content="🗑 Temizle" Padding="8,3" FontSize="11" Margin="0,0,4,0"
                                            Click="BtnClearTiaLogs_Click"/>
                                    <Button x:Name="BtnCopyTiaLogs" Style="{StaticResource SlateToolButton}" Content="📋 Kopyala" Padding="8,3" FontSize="11"
                                            Click="BtnCopyTiaLogs_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Detaylı Openness & Derleme Console TextBox (Tüm Genişlik ve Yükseklik) -->
                            <TextBox x:Name="TxtDetailedLog" Grid.Row="1" FontFamily="Consolas" FontSize="11.5"
                                     IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="{DynamicResource BgBox}" Foreground="{DynamicResource TextConsole}" Padding="8" BorderThickness="0"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
